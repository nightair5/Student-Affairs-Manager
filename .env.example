# Local service only. Copy to .env and replace placeholders on your machine.
# Never commit real secrets or student data.
SAM_SERVICE_HOST=127.0.0.1
SAM_SERVICE_PORT=8787
SAM_ALLOWED_ORIGIN=http://localhost:4173
SAM_SYNC_TOKEN=replace-with-a-long-random-token
SAM_DATA_DIR=.data

# Email delivery remains disabled until a server-side webhook provider is configured.
# The webhook must be an email gateway you control. Its token never enters Vite.
SAM_EMAIL_PROVIDER=disabled
SAM_EMAIL_FROM=
SAM_EMAIL_WEBHOOK_URL=
SAM_EMAIL_WEBHOOK_TOKEN=

# Web fetching is opt-in and accepts public HTTPS HTML/text pages only.
# Local/private/IP targets, credentials, non-standard ports and unsafe redirects are blocked.
SAM_WEB_FETCH_ENABLED=false

# Optional local Node service DeepSeek proxy. Firebase Hosting and Cloudflare do not read this file.
# Firebase Functions and Cloudflare Worker deployments must use their own server-side Secret mechanisms.
# Never expose this key through VITE_* variables; leave it empty by default.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# Aliyun / plain Linux public server (npm run serve:public).
# Nginx should own ports 80 and 443 and proxy /api to this loopback process.
# Put the real DEEPSEEK_API_KEY only in the server's private env file, never in Git.
# SAM_HTTPS=true only after this machine itself terminates HTTPS.
SAM_PUBLIC_HOST=127.0.0.1
SAM_PUBLIC_PORT=8788
SAM_STATIC_DIR=dist
SAM_HTTPS=false
# Hostnames this public server accepts, besides localhost. Unknown Host values are rejected.
SAM_ALLOWED_HOSTS=student-affairs.site,118.178.194.96
# Extra browser origins, comma-separated. Same-origin requests are allowed without this.
ALLOWED_ORIGINS=
