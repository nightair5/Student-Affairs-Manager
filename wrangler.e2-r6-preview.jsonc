{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "student-affairs-manager-preview",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  "routes": [],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "E2_PATH_A_REPAIR_EXPERIMENT_ENABLED": "false",
    "E2_V4_PRO_BENCHMARK_ENABLED": "false",
    "E2_R2_BENCHMARK_ENABLED": "false",
    "E2_R3_BENCHMARK_ENABLED": "false",
    "E2_R4_BENCHMARK_ENABLED": "false",
    "E2_R5_BENCHMARK_ENABLED": "false",
    "E2_R6_HARNESS_ENABLED": "true",
    "E2_R6_PREVIEW_ORIGIN": "https://student-affairs-manager-preview.nightsdell.workers.dev",
    "E2_R6_QUALIFICATION_BUNDLE_SHA256": "e3e10c2e9acf6418ca6184ed4260b0d9e6985d2f63d4266ae6be51d07d362413",
    "E2_R6_QUALIFICATION_RESULT_SHA256": "7bb513ee810e2daa996e2dcaa0ecfb70d5ec8eb79bf7024ecb410f0d303b3c2a"
  },
  "services": [
    {
      "binding": "E2_R6_QUALIFICATION_LEDGER",
      "service": "student-affairs-e2-r6-qualification-ledger-preview"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
