{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "student-affairs-e2-r6-qualification-preview",
  "main": "./cloudflare/e2-r6-qualification-worker.mjs",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "E2_R6_HARNESS_ENABLED": "true",
    "E2_R6_VERSIONED_PREVIEW_ONLY": "true",
    "E2_R6_PREVIEW_ORIGIN": "https://student-affairs-e2-r6-qualification-preview.nightsdell.workers.dev",
    "E2_R6_QUALIFICATION_BUNDLE_SHA256": "e204369f0bea06463d86988aa7be6ce44f2b663567c0d4483241eb1f096c6565",
    "E2_R6_QUALIFICATION_RESULT_SHA256": "9cb941991570a924b75532a796502e91d849cba3586bb2fe59a7c37a4b776d16"
  },
  "services": [
    {
      "binding": "E2_R6_QUALIFICATION_LEDGER",
      "service": "student-affairs-e2-r6-qualification-ledger-preview"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
