{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sa-e2-r10-facts-first-qual-preview",
  "main": "./cloudflare/e2-r10-qualification-worker.mjs",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "E2_R10_QUALIFICATION_ENABLED": "true",
    "E2_R10_VERSIONED_PREVIEW_ONLY": "true",
    "E2_R10_QUALIFICATION_PREVIEW_ORIGIN": "https://sa-e2-r10-facts-first-qual-preview.nightsdell.workers.dev",
    "E2_R10_PROTOCOL_BUNDLE_SHA256": "411492acd49bad08dff70992cf268463e822ea5b0bafdaaf1dd877c5e58abb65",
    "E2_R10_QUALIFICATION_RESULT_SHA256": "1f105fbeb6e5666f6e0e3d90a2782af0c3097d510343934e79ba752a384dbf5a",
    "E2_R10_QUALIFICATION_WORKER_BYTES_SHA256": "4cb94c79b89b5b81916dc51ad9b2395ca1485e9b0eab8ebdfdb1277fd35001a1",
    "E2_R10_QUALIFICATION_WORKER_CONFIG_SHA256": "f4d25c2218558b2e2ded89e17a6fd086e06228faceff773143236cf035f22ef4",
    "E2_R10_LEDGER_WORKER_VERSION_ID": "84682e6e-fb74-4aba-92f5-33b7dd91bc7e",
    "E2_R10_LEDGER_WORKER_BYTES_SHA256": "0903c47a38bb11aa14757891d56024278d91502b23ae600ea8f7ded2d8dc3a8e",
    "E2_R10_LEDGER_WORKER_CONFIG_SHA256": "739f9235efc29e6fab662a81cc5ff46b71939d471e23005387f97fe2f57b589a"
  },
  "services": [
    {
      "binding": "E2_R10_QUALIFICATION_LEDGER",
      "service": "student-affairs-e2-r10-facts-first-qualification-ledger-preview"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
