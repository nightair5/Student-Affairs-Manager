{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sa-e2-r10-facts-first-qual-preview",
  "main": "./cloudflare/e2-r10-qualification-worker.mjs",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "E2_R10_QUALIFICATION_ENABLED": "true",
    "E2_R10_VERSIONED_PREVIEW_ONLY": "true",
    "E2_R10_QUALIFICATION_PREVIEW_ORIGIN": "https://sa-e2-r10-facts-first-qual-preview.nightsdell.workers.dev",
    "E2_R10_PROTOCOL_BUNDLE_SHA256": "03d3372bc8ef7355395474add67a59c78fa178e04fea8af90ee9be6ab418ce94",
    "E2_R10_QUALIFICATION_RESULT_SHA256": "f1c5cf9308edc71960457c3cd20a00bc78be20ed5433ffab1300d5dafa45692a",
    "E2_R10_QUALIFICATION_WORKER_BYTES_SHA256": "0634c295e74d2e3db2c5d575b977496c6aeb5581802af5f27ce51cdc7b64cbc1",
    "E2_R10_QUALIFICATION_WORKER_CONFIG_SHA256": "f4d25c2218558b2e2ded89e17a6fd086e06228faceff773143236cf035f22ef4",
    "E2_R10_LEDGER_WORKER_VERSION_ID": "4e0270d9-ca78-438d-b66c-cf337b12d8e7",
    "E2_R10_LEDGER_WORKER_BYTES_SHA256": "5f27a724b57bd4da14bd2d3ef7beae28cf90b5ecb117df53d23a0697cfef16c2",
    "E2_R10_LEDGER_WORKER_CONFIG_SHA256": "739f9235efc29e6fab662a81cc5ff46b71939d471e23005387f97fe2f57b589a"
  },
  "services": [
    {
      "binding": "E2_R10_QUALIFICATION_LEDGER",
      "service": "student-affairs-e2-r10-facts-first-qualification-ledger-preview"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
