{
  "name": "student-affairs-steward",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "server:check": "node --check server/index.mjs && node --check server/app.mjs && node --check server/web-fetch-service.mjs && node --check server/deepseek-service.mjs && npm --prefix functions run check",
    "build": "tsc -b && vite build",
    "build:firebase": "tsc -b && vite build --mode firebase",
    "firebase:serve": "npm run build:firebase && npx --yes firebase-tools emulators:start --only hosting",
    "deploy:firebase": "npm run build:firebase && npm --prefix functions run check && npx --yes firebase-tools deploy --only functions,hosting",
    "cloudflare:dev": "npm run build && wrangler dev",
    "cloudflare:check": "node --test cloudflare/worker-tests.mjs cloudflare/e2-r2-tests.mjs cloudflare/e2-r3-tests.mjs cloudflare/e2-r4-tests.mjs && wrangler deploy --dry-run --config wrangler.e2-r2-ledger.jsonc && wrangler deploy --dry-run --config wrangler.e2-r3-ledger.jsonc && wrangler deploy --dry-run --config wrangler.e2-r3-preview.jsonc && wrangler deploy --dry-run --config wrangler.e2-r4-ledger.jsonc && wrangler deploy --dry-run --config wrangler.e2-r4-preview.jsonc && wrangler deploy --dry-run --env=\"\" && wrangler deploy --dry-run --env preview",
    "security:scan": "node scripts/scan-secrets.mjs",
    "deploy:cloudflare:preview": "npm run build && npm run cloudflare:check && wrangler deploy --env preview",
    "deploy:cloudflare": "npm run build && npm run cloudflare:check && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && node --test scripts/recognition-e2-dataset-freeze.mjs scripts/factledger-d6-labels.node.mjs scripts/e2-7-baseline-freeze.node.mjs scripts/e2-9-r1-protocol.node.mjs scripts/e2-9-r2-protocol.node.mjs scripts/e2-9-r3-protocol.node.mjs scripts/e2-9-r4-path-mask.node.mjs scripts/e2-9-r4-protocol.node.mjs && node --test server/server-tests.mjs && node --test cloudflare/worker-tests.mjs cloudflare/e2-r2-tests.mjs cloudflare/e2-r3-tests.mjs cloudflare/e2-r4-tests.mjs && npm --prefix functions test",
    "test:e2.7:baseline": "node --test scripts/e2-7-baseline-freeze.node.mjs",
    "eval:recognition": "vitest run src/recognition/evaluation.test.ts",
    "eval:recognition:e2": "node scripts/run-recognition-e2.mjs",
    "eval:recognition:e2:factledger": "node scripts/run-factledger-ab.mjs",
    "eval:recognition:e2:factledger:d5": "node scripts/summarize-factledger-d5.mjs",
    "eval:recognition:e2:factledger:d6": "node scripts/audit-factledger-d6.mjs",
    "eval:recognition:e2:p2:prepare": "node scripts/prepare-e2-7-blind-adjudication.mjs",
    "eval:recognition:e2:p2:verify": "node scripts/verify-e2-7-blind-adjudication.mjs",
    "eval:recognition:e2:p2:reveal": "node scripts/reveal-e2-7-blind-adjudication.mjs",
    "eval:recognition:e2:p2:summarize": "node scripts/summarize-e2-7-p2.mjs",
    "eval:recognition:e2:p2b:prepare": "node scripts/prepare-e2-7-blind-adjudication.mjs --packet=.evaluation-cache/e2-7/p2b-full-packet.json --manifest=docs/e2-path-a-planning/p2b-full-packet-manifest.json --labels=docs/e2-path-a-planning/p2b-full-labels.json --key=docs/e2-path-a-planning/p2b-reveal-key.json --schema-version=e2.7-blind-packet-1.1.0 --selection-version=e2.7-p2-source-hash-stratified-1.1.0 --observation-prefix=E2P2B",
    "eval:recognition:e2:p2b:verify": "node scripts/verify-e2-7-blind-adjudication-v2.mjs",
    "eval:recognition:e2:p2b:reveal": "node scripts/reveal-e2-7-blind-adjudication.mjs --packet=.evaluation-cache/e2-7/p2b-full-packet.json --manifest=docs/e2-path-a-planning/p2b-full-packet-manifest.json --labels=docs/e2-path-a-planning/p2b-full-labels.json --key=docs/e2-path-a-planning/p2b-reveal-key.json",
    "eval:recognition:e2:p2b:summarize": "node scripts/summarize-e2-7-p2b.mjs",
    "eval:recognition:e2:p3:prepare": "node scripts/prepare-e2-7-p3-audit.mjs",
    "eval:recognition:e2:p3:summarize": "node scripts/summarize-e2-7-p3-audit.mjs",
    "eval:recognition:e2:p4": "node scripts/evaluate-e2-7-p4-normalizer.mjs"
    ,"eval:recognition:e2:r2:prepare": "node scripts/prepare-e2-9-r2-manifests.mjs"
    ,"eval:recognition:e2:r2:run": "node scripts/run-e2-9-r2.mjs"
    ,"eval:recognition:e2:r2:score": "node scripts/score-e2-9-r2.mjs"
    ,"eval:recognition:e2:r3:prepare": "node scripts/prepare-e2-9-r3-manifests.mjs"
    ,"eval:recognition:e2:r3:run": "node scripts/run-e2-9-r3.mjs"
    ,"eval:recognition:e2:r3:score": "node scripts/score-e2-9-r3.mjs"
    ,"eval:recognition:e2:r3:adjudication": "node scripts/prepare-e2-9-r3-adjudication.mjs"
    ,"eval:recognition:e2:r3:reveal": "node scripts/reveal-e2-9-r3-adjudication.mjs"
    ,"eval:recognition:e2:r3:gate": "node scripts/evaluate-e2-9-r3-gate.mjs"
    ,"eval:recognition:e2:r4:prepare": "node scripts/prepare-e2-9-r4-manifests.mjs"
    ,"eval:recognition:e2:r4:preflight": "node scripts/e2-9-r4-entrypoint-preflight.mjs"
    ,"eval:recognition:e2:r4:run": "node scripts/run-e2-9-r4.mjs"
    ,"eval:recognition:e2:r4:score": "node scripts/score-e2-9-r4.mjs"
    ,"eval:recognition:e2:r4:gate": "node scripts/evaluate-e2-9-r4-gate.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.118.0"
  }
}
