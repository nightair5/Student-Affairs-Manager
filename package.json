{
  "name": "student-affairs-steward",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "server:check": "node --check server/index.mjs && node --check server/app.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run && node --test server/server-tests.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
