{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "e2.9-r6-private-binding-manifest-1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "runId", "reviewerPacketSha256", "pairs"],
  "properties": {
    "schemaVersion": { "const": "e2.9-r6-private-binding-manifest-1.0.0" },
    "protocolVersion": { "type": "string" },
    "runId": { "type": "string" },
    "reviewerPacketSha256": { "$ref": "#/$defs/sha256" },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseAnonymousId", "caseId", "XAlias", "YAlias", "sideXHash", "sideYHash", "assignmentCommitmentHash"],
        "properties": {
          "caseAnonymousId": { "type": "string" },
          "caseId": { "type": "string" },
          "XAlias": { "enum": ["flash", "pro"] },
          "YAlias": { "enum": ["flash", "pro"] },
          "sideXHash": { "$ref": "#/$defs/sha256" },
          "sideYHash": { "$ref": "#/$defs/sha256" },
          "assignmentCommitmentHash": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
