      "referenceTime": "2026-10-03T09:00:00+08:00",
      "timezone": "Asia/Shanghai",
      "role": "NEW_MODEL_ASSISTED_SYNTHETIC_DEVELOPMENT_NOT_HOLDOUT",
      "targets": [
        "QUALIFICATION_VS_PREREQUISITE"
