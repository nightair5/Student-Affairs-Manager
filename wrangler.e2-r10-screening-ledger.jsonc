{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "student-affairs-e2-r10-screening-ledger-preview",
  "main": "./cloudflare/e2-r10-screening-ledger.mjs",
  "compatibility_date": "2026-08-24",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "E2_R10_SCREENING_LEDGER", "class_name": "E2R10ScreeningLedger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["E2R10ScreeningLedger"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
