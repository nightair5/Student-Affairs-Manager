{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "student-affairs-manager",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "student-affairs.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/benchmark*",
      "/e2*",
      "/fact-ledger*",
      "/factledger*",
      "/selection*",
      "/blind*",
      "/research-preview*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "env": {
    "preview": {
      "name": "student-affairs-manager-preview",
      "workers_dev": true,
      "routes": [],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/benchmark*",
          "/e2*",
          "/fact-ledger*",
          "/factledger*",
          "/selection*",
          "/blind*",
          "/research-preview*"
        ]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      }
    }
  }
}
