{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "student-affairs-manager",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  "vars": {
    "RECOGNITION_LOCAL_ISOLATION_VERSION": "1.0.0",
    "DEEPSEEK_GENERATION_MODE": "two-step-2.4",
    "TWO_STEP_COMPILER_VERSION": "2.1.15",
    "DEEPSEEK_NETWORK_RETRY": "0",
    "DEEPSEEK_MODEL": "deepseek-v4-flash",
    "DEEPSEEK_EXTRACTION_MAX_TOKENS": "16384",
    "EXTRACTION_EDGE_RATE_REQUIRED": "true"
  },
  "routes": [
    {
      "pattern": "student-affairs.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/benchmark*",
      "/e2*",
      "/fact-ledger*",
      "/factledger*",
      "/selection*",
      "/blind*",
      "/research-preview*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "env": {
    "preview": {
      "name": "student-affairs-manager-preview",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "RECOGNITION_LOCAL_ISOLATION_VERSION": "1.0.0",
        "DEEPSEEK_EXTRACTION_MAX_TOKENS": "16384",
        "PREVIEW_ACCESS_REQUIRED": "true"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      }
    },
    "multimodal_preview": {
      "name": "student-affairs-manager-multimodal-exp",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "ENABLE_MULTIMODAL_EVALUATION": "true"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*",
          "/benchmark*",
          "/e2*",
          "/fact-ledger*",
          "/factledger*",
          "/selection*",
          "/blind*",
          "/research-preview*"
        ]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      }
    }
  },
  "ratelimits": [
    {
      "name": "EXTRACTION_RATE_LIMITER",
      "namespace_id": "2026102219",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
