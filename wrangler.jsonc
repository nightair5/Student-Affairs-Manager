{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "student-affairs-manager",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "student-affairs.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "env": {
    "preview": {
      "name": "student-affairs-manager-preview",
      "workers_dev": true,
      "routes": [],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "vars": {
        "E2_PATH_A_REPAIR_EXPERIMENT_ENABLED": "false",
        "E2_V4_PRO_BENCHMARK_ENABLED": "false",
        "E2_R2_BENCHMARK_ENABLED": "false",
        "E2_R2_PREVIEW_ORIGIN": "https://student-affairs-manager-preview.nightsdell.workers.dev",
        "E2_R3_BENCHMARK_ENABLED": "false",
        "E2_R3_PREVIEW_ORIGIN": "https://student-affairs-manager-preview.nightsdell.workers.dev",
        "E2_R4_BENCHMARK_ENABLED": "false",
        "E2_R4_PREVIEW_ORIGIN": "https://student-affairs-manager-preview.nightsdell.workers.dev",
        "E2_R5_BENCHMARK_ENABLED": "false",
        "E2_R5_PREVIEW_ORIGIN": "https://student-affairs-manager-preview.nightsdell.workers.dev",
        "E2_R6_HARNESS_ENABLED": "false",
        "E2_R6_PREVIEW_ORIGIN": "https://student-affairs-manager-preview.nightsdell.workers.dev",
        "E2_R6_QUALIFICATION_BUNDLE_SHA256": "e204369f0bea06463d86988aa7be6ce44f2b663567c0d4483241eb1f096c6565",
        "E2_R6_QUALIFICATION_RESULT_SHA256": "9cb941991570a924b75532a796502e91d849cba3586bb2fe59a7c37a4b776d16"
      },
      "services": [
        {
          "binding": "E2_R2_LEDGER",
          "service": "student-affairs-e2-r2-ledger-preview"
        },
        {
          "binding": "E2_R3_LEDGER",
          "service": "student-affairs-e2-r3-ledger-preview"
        },
        {
          "binding": "E2_R4_LEDGER",
          "service": "student-affairs-e2-r4-ledger-preview"
        },
        {
          "binding": "E2_R5_LEDGER",
          "service": "student-affairs-e2-r5-ledger-preview"
        }
      ],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/api/*"
        ]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1
        }
      }
    }
  }
}
