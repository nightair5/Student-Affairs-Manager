{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "student-affairs-real-input-preview",
  "main": "./cloudflare/real-input-preview.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "./.data/real-input-preview-assets",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {"enabled": false}
}
